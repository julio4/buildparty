{
  "name": "build-party",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch src/server.ts",
    "db:migrate": "tsx src/migrate.ts",
    "test": "node --import tsx --test test/domain.test.ts test/presence.test.ts test/production-static.test.ts test/webmcp.test.ts test/workspace.test.ts test/agent-journey-eval.test.ts",
    "eval:agent:check": "node --import tsx --test test/agent-journey-eval.test.ts",
    "eval:agent:openai": "tsx scripts/agent-journey-eval.ts openai",
    "eval:agent:gemini": "tsx scripts/agent-journey-eval.ts gemini",
    "test:service": "node --import tsx --test test/service.integration.test.ts",
    "test:electric": "node scripts/electric-integration.mjs",
    "test:e2e": "node scripts/golden-e2e.mjs",
    "test:production-harness": "node scripts/check-production-harness.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build"
  },
  "dependencies": {
    "@electric-sql/client": "^1.5.26",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
